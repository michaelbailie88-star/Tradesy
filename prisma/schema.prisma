// Vettd Marketplace — schema.prisma
// Three-sided marketplace: Homeowners/Businesses post Jobs, Contractors submit Bids.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  name            String?
  image           String?
  role            String    @default("HOMEOWNER") // HOMEOWNER, CONTRACTOR, ADMIN
  customerType    String    @default("homeowner") // homeowner, business, contractor
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Business-specific
  businessName    String?
  businessType    String?   // restaurant, cafe, salon, retail, office, landlord, other
  businessAddress String?
  hstNumber       String?
  siteContactName String?
  siteContactPhone String?

  // Contractor-specific
  stripeAccountId String?
  payoutsEnabled  Boolean   @default(false)
  trade           String?
  serviceRadius   Int?
  rating          Float?    @default(0)
  takesCommercial Boolean   @default(false) // toggle for commercial work

  // Verification flags
  isIdentityVerified Boolean @default(false)
  isLicensed         Boolean @default(false)
  isInsured          Boolean @default(false)
  isWSIBClear        Boolean @default(false) // WSIB compliance

  // Homeowner-specific
  stripeCustomerId String?

  // Password reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  jobsPosted      Job[]     @relation("JobsPosted")
  bids            Bid[]
  reviews         Review[]  @relation("ReviewAuthor")
  reviewsReceived Review[]  @relation("ReviewSubject")
  messagesSent    Message[] @relation("MessageSender")
  notifications   Notification[]
  services        Service[]

  @@index([email])
  @@index([trade])
  @@index([customerType])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  budget      Int?
  location    String
  timeline    String?
  photos      String?
  status      String   @default("OPEN") // OPEN, AWARDED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Business-specific
  accessHours    String?  // e.g. "After 6pm", "Weekends only"
  siteContact    String?  // On-site contact person
  recurring      Boolean? @default(false) // Recurring maintenance

  homeownerId String
  homeowner   User     @relation("JobsPosted", fields: [homeownerId], references: [id])

  bids        Bid[]
  payment     Payment?
  messages    Message[]

  @@index([category])
  @@index([status])
  @@index([homeownerId])
  @@index([createdAt])
}

model Bid {
  id           String   @id @default(cuid())
  amount       Int
  message      String?
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN
  createdAt    DateTime @default(now())

  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])

  contractorId String
  contractor   User     @relation(fields: [contractorId], references: [id])

  @@index([jobId])
  @@index([contractorId])
  @@index([status])
}

model Payment {
  id              String   @id @default(cuid())
  jobId           String   @unique
  job             Job      @relation(fields: [jobId], references: [id])
  amount          Int
  platformFee     Int
  status          String   @default("PENDING")
  stripePaymentIntentId String?
  stripeTransferId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId  String
  subject    User     @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@index([subjectId])
  @@index([authorId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([jobId])
  @@index([senderId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // bid_received, bid_accepted, message, job_closed, review_received
  title     String
  body      String?
  read      Boolean  @default(false)
  link      String?  // URL to relevant page
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // matches trade category
  priceType   String   @default("fixed") // fixed, hourly, quote
  price       Int?     // cents, for fixed/hourly pricing
  duration    String?  // e.g. "2-3 hours", "Full day"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contractorId String
  contractor   User     @relation(fields: [contractorId], references: [id])

  @@index([contractorId])
  @@index([category])
  @@index([active])
}
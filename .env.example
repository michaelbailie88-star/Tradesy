# ============================================================
# Tradesy — Environment Variables
# ============================================================
# Copy this file to .env for local development.
# For production (Vercel), set these as Environment Variables
# in the Vercel Dashboard: Settings > Environment Variables.
# Then hit Redeploy.
# ============================================================

# --- Database (Required) ---
# Local development: Use SQLite for simplicity
# DATABASE_URL="file:./dev.db"
#
# Production (Vercel): Use Neon PostgreSQL
# Get your connection string from Neon Dashboard -> Connection Details
# DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- NextAuth (Required) ---
# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET="tradesy-dev-secret-change-in-production"
# For local dev: http://localhost:3000
# For production (Vercel): https://tradesy-o7yz.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (Required for payments) ---
# Get these from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."